#!/usr/bin/env bash
set -euo pipefail
# 与 verify 第 3 步口径一致：只扫 src/。测试里对快照结果做 max/min 断言是正当用法，不是未来函数
files=()
while IFS= read -r file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.py')
if ((${#files[@]} == 0)); then
  exit 0
fi
uv run python -m q6.lint.lookahead_ast "${files[@]}"
